{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "es2022"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@earendil-works/pi-coding-agent": [
        "node_modules/@earendil-works/pi-coding-agent/dist/index.d.ts"
      ],
      "@earendil-works/pi-ai": [
        "node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-ai/dist/index.d.ts"
      ],
      "@earendil-works/pi-ai/compat": [
        "node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-ai/dist/compat.d.ts"
      ],
      "@earendil-works/pi-agent-core": [
        "node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-agent-core/dist/index.d.ts"
      ]
    }
  },
  // Every .ts in every subdirectory (store/, narrative/, ledger/) is type-checked (source, CLI, probes, tests) so a new
  // file cannot land outside the gate. The previous explicit list had gone
  // stale (observe.ts, probe.ts, timings.ts, ... were never checked) — that is
  // how an untested shape can rot unnoticed. load-smoke.mjs is a tool, not
  // product code: deliberately .mjs, deliberately not type-checked here.
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "eval/**/*.ts"
  ]
}
